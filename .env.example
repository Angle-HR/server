# Copy to .env and fill in real values. Never commit .env — it is listed in .gitignore.

# --- PostgreSQL (single instance, six databases) ---
# Used by the postgres, migrate and service containers in docker-compose.yml. `make local-up` also loads
# deploy/local/remote.env (the service wiring); values here and in your shell override it.
POSTGRES_PASSWORD=change-me
# Host port mapping for the single Postgres instance (default 5432).
POSTGRES_PORT=5432

# --- MinIO (local S3-compatible object storage) ---
# docker compose runs MinIO and wires the server to http://minio:9000 automatically.
# API: http://localhost:9000  Console: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# When running the server outside compose, point R2_* at the published MinIO port:
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin

# --- Redis (shared instance) ---
# Required by the server at startup. REDIS_PORT maps the container to your host.
REDIS_PORT=6379
REDIS_DB=0
# Host URL when running the app outside docker compose (server/worker in compose use redis:6379).
REDIS_URL=redis://localhost:6379/0

# --- Application (server) ---
# For docker compose, server/worker use internal hostnames (postgres, redis, …).
# Run: docker compose up --build
SERVER_PORT=8080
APP_ENV=development
# Log verbosity: debug, info, warn, error. Empty defaults to debug in development, info otherwise.
LOG_LEVEL=debug

# Origin used by OpenAPI / Scalar (Try it out). Defaults to http://localhost:SERVER_PORT
PUBLIC_API_URL=http://localhost:8080
# Origin of the frontend that serves the public job pages (/j/{public_id}, /j/{public_id}/apply). Share links are
# built from it (the privacy notice link uses PUBLIC_API_URL). Staging: https://staging.tryopenhr.com. Production: https://tryopenhr.com
PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call /api/v1/* (CORS). Omit to disable CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Sessions (server-side, cookie based; replaces JWT_*) ---
# Sliding idle timeout and absolute lifetime, in seconds.
SESSION_IDLE_TTL=7200
SESSION_ABSOLUTE_TTL=43200
# Secure + __Host- cookie prefix. Set false ONLY for plain-http local development.
COOKIE_SECURE=false
# Origin/Referer allow-list for POST/PUT/PATCH/DELETE. Defaults to CORS_ALLOWED_ORIGINS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Encrypts TOTP secrets at rest. REQUIRED (16+ chars, random) when APP_ENV is production, prod or staging: the
# service refuses to start without it or with the development default. In development it falls back to JWT_SECRET,
# then to an insecure built-in key. Rotation: set the new key here, put the old one in TOTP_ENCRYPTION_KEY_PREVIOUS
# (comma separated), deploy, then remove the previous key once old secrets are no longer in use. See docs/microservices/hardening.md.
# TOTP_ENCRYPTION_KEY=
# TOTP_ENCRYPTION_KEY_PREVIOUS=

# --- Notifications service ---
# Its own database (events_inbox only; migrated by db/migrations/notifications). Unset: the service uses DB_URL_GLOBAL.
# NOTIFICATIONS_DB_URL=postgres://openhr:change-me@localhost:5432/openhr_notifications?sslmode=disable
# How long email requests stay on the bus (they carry one-time codes). Go duration, 5m..168h, default 24h.
# Must be identical for every process that publishes or consumes the notifications stream.
# NOTIFICATIONS_STREAM_MAX_AGE=24h

# --- Admin bootstrap (created once when admin.users is empty) ---
# Force every admin to enrol an authenticator (password-only sessions can then only enrol). Unset: true in
# production/staging, false elsewhere; false is refused in production/staging.
# ADMIN_TOTP_REQUIRED=false
ADMIN_BOOTSTRAP_EMAIL=admin@anglehr.local
ADMIN_BOOTSTRAP_PASSWORD=changeme123
ADMIN_BOOTSTRAP_NAME=Bootstrap Admin

# React Fluvio dashboard origin (development only; CORS for /fluvio/api/*). Defaults to http://localhost:5173
FLUVIO_UI_ORIGIN=http://localhost:5173

# Set to true when Postgres is behind PgBouncer transaction pooling (disables LISTEN/NOTIFY).
# FLUVIO_POLL_ONLY=true

# --- Regional database router (server) ---
# All regions are required at startup. Same host, different dbname / bucket.
ANGLEHR_UK_POSTGRES_DSN=postgres://openhr:change-me@localhost:5432/openhr_uk?sslmode=disable
ANGLEHR_UK_R2_BUCKET=openhr-uk

ANGLEHR_US_POSTGRES_DSN=postgres://openhr:change-me@localhost:5432/openhr_us?sslmode=disable
ANGLEHR_US_R2_BUCKET=openhr-us

ANGLEHR_AFRICA_POSTGRES_DSN=postgres://openhr:change-me@localhost:5432/openhr_africa?sslmode=disable
ANGLEHR_AFRICA_R2_BUCKET=openhr-africa

ANGLEHR_EU_POSTGRES_DSN=postgres://openhr:change-me@localhost:5432/openhr_eu?sslmode=disable
ANGLEHR_EU_R2_BUCKET=openhr-eu

ANGLEHR_ASIA_POSTGRES_DSN=postgres://openhr:change-me@localhost:5432/openhr_asia?sslmode=disable
ANGLEHR_ASIA_R2_BUCKET=openhr-asia

# --- Global registry (services + migrate) ---
# The server and migrate use ANGLEHR_*_POSTGRES_DSN for regions and DB_URL_GLOBAL for global.
DB_URL_GLOBAL=postgres://openhr:change-me@localhost:5432/openhr_global?sslmode=disable

# --- SMTP / MailHog (notifications service) ---
# docker compose runs MailHog; the notifications service defaults to host mailhog:1025 (no auth).
# Web UI: http://localhost:8025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@anglehr.local
SMTP_FROM_NAME=OpenHR
# Product frontend origin: the only source of the links in product emails (password reset, org invite, dashboard).
# Required, https, in staging/production (the mailer processes refuse to start without it).
APP_URL=http://localhost:3000
# Admin console origin: the only source of the admin invite link. Invite tokens expire after 72 hours.
# Links: {{ADMIN_APP_URL}}/admin/accept-invite?token=...
ADMIN_APP_URL=http://localhost:3001

# Company verification (KYB). Without a key, UK companies go to manual review.
COMPANIES_HOUSE_API_KEY=

# --- Microservice split switches (all default to the monolith behaviour; see docs/microservices/switches.md) ---
# APPLICATIONS_REMOTE=off
# HIRING_REMOTE=off
# ORG_REMOTE=off
# IDENTITY_REMOTE=off
# APPLICATIONS_EVENTS=off
# HIRING_EVENTS=off
# ORG_EVENTS=off
# IDENTITY_EVENTS=off
# APPLICATIONS_ORG_EVENTS=off
# APPLICATIONS_JOBSOURCE=db      # db | events
# CALLER_RESOLVER=db             # db | grpc
# APPLICANT_COUNTS=db            # db | grpc
# ORG_READINESS=db               # db | grpc (also ORG_MEMBERSHIP, ORG_INDUSTRIES, ORG_TENANTS)
# ORG_APPLY=db                   # db | grpc
# IDENTITY_QUEUE=db              # db | grpc
# SESSION_VALIDATION=off         # web-bff
