# Copy to .env and fill in real values. Never commit .env — it is listed in .gitignore.

# --- PostgreSQL (per-region and global registry passwords) ---
# Used by postgres_<region>, postgres_global, and migrate services in docker-compose.yml.
POSTGRES_PASSWORD_UK=change-me-uk
POSTGRES_PASSWORD_US=change-me-us
POSTGRES_PASSWORD_AFRICA=change-me-africa
POSTGRES_PASSWORD_EU=change-me-eu
POSTGRES_PASSWORD_GLOBAL=change-me-global

# --- MinIO (per-region root credentials) ---
# Used by minio_<region> services in docker-compose.yml.
MINIO_ROOT_USER_UK=minio_uk_user
MINIO_ROOT_PASSWORD_UK=change-me-minio-uk
MINIO_ROOT_USER_US=minio_us_user
MINIO_ROOT_PASSWORD_US=change-me-minio-us
MINIO_ROOT_USER_AFRICA=minio_africa_user
MINIO_ROOT_PASSWORD_AFRICA=change-me-minio-africa
MINIO_ROOT_USER_EU=minio_eu_user
MINIO_ROOT_PASSWORD_EU=change-me-minio-eu

# --- Redis (shared instance) ---
# Connect from the host when running docker compose locally.
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL URLs (host; for make migrate-up / psql from your machine) ---
# The migrate service builds internal URLs from POSTGRES_PASSWORD_* automatically.
# Substitute the matching password from above (URL-encode special characters if needed).
DB_URL_UK=postgres://anglehr:change-me-uk@localhost:5432/anglehr_uk?sslmode=disable
DB_URL_US=postgres://anglehr:change-me-us@localhost:5433/anglehr_us?sslmode=disable
DB_URL_AFRICA=postgres://anglehr:change-me-africa@localhost:5434/anglehr_africa?sslmode=disable
DB_URL_EU=postgres://anglehr:change-me-eu@localhost:5435/anglehr_eu?sslmode=disable
DB_URL_GLOBAL=postgres://anglehr:change-me-global@localhost:5436/anglehr_global?sslmode=disable

# --- MinIO (host connection hints) ---
# MinIO UK API: http://localhost:9000  Console: http://localhost:9001
# MinIO US API: http://localhost:9002  Console: http://localhost:9003
# MinIO Africa API: http://localhost:9004  Console: http://localhost:9005
# MinIO EU API: http://localhost:9006  Console: http://localhost:9007
