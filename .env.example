# Copy to .env and fill in real values. Never commit .env — it is listed in .gitignore.

# --- PostgreSQL (single instance, six databases) ---
# Used by the postgres, migrate, server, and email-worker services in docker-compose.yml.
POSTGRES_PASSWORD=change-me
# Host port mapping for the single Postgres instance (default 5432).
POSTGRES_PORT=5432

# --- MinIO (local S3-compatible object storage) ---
# docker compose runs MinIO and wires the server to http://minio:9000 automatically.
# API: http://localhost:9000  Console: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# When running the server outside compose, point R2_* at the published MinIO port:
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin

# --- Redis (shared instance) ---
# Required by the server at startup. REDIS_PORT maps the container to your host.
REDIS_PORT=6379
REDIS_DB=0
# Host URL when running the app outside docker compose (server/worker in compose use redis:6379).
REDIS_URL=redis://localhost:6379/0

# --- Application (server) ---
# For docker compose, server/worker use internal hostnames (postgres, redis, …).
# Run: docker compose up --build
SERVER_PORT=8080
APP_ENV=development

# Origin used by OpenAPI / Scalar (Try it out). Defaults to http://localhost:SERVER_PORT
PUBLIC_API_URL=http://localhost:8080

# Comma-separated browser origins allowed to call /api/v1/* (CORS). Omit to disable CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Admin bootstrap (created once when admin.users is empty) ---
ADMIN_BOOTSTRAP_EMAIL=admin@anglehr.local
ADMIN_BOOTSTRAP_PASSWORD=changeme123
ADMIN_BOOTSTRAP_NAME=Bootstrap Admin

# React Fluvio dashboard origin (development only; CORS for /fluvio/api/*). Defaults to http://localhost:5173
FLUVIO_UI_ORIGIN=http://localhost:5173

# Set to true when Postgres is behind PgBouncer transaction pooling (disables LISTEN/NOTIFY).
# FLUVIO_POLL_ONLY=true

# --- Regional database router (server) ---
# All regions are required at startup. Same host, different dbname / bucket.
ANGLEHR_UK_POSTGRES_DSN=postgres://anglehr:change-me@localhost:5432/anglehr_uk?sslmode=disable
ANGLEHR_UK_R2_BUCKET=anglehr-uk

ANGLEHR_US_POSTGRES_DSN=postgres://anglehr:change-me@localhost:5432/anglehr_us?sslmode=disable
ANGLEHR_US_R2_BUCKET=anglehr-us

ANGLEHR_AFRICA_POSTGRES_DSN=postgres://anglehr:change-me@localhost:5432/anglehr_africa?sslmode=disable
ANGLEHR_AFRICA_R2_BUCKET=anglehr-africa

ANGLEHR_EU_POSTGRES_DSN=postgres://anglehr:change-me@localhost:5432/anglehr_eu?sslmode=disable
ANGLEHR_EU_R2_BUCKET=anglehr-eu

ANGLEHR_ASIA_POSTGRES_DSN=postgres://anglehr:change-me@localhost:5432/anglehr_asia?sslmode=disable
ANGLEHR_ASIA_R2_BUCKET=anglehr-asia

# --- Global registry (server + email-worker + migrate) ---
# The server and migrate use ANGLEHR_*_POSTGRES_DSN for regions and DB_URL_GLOBAL for global.
DB_URL_GLOBAL=postgres://anglehr:change-me@localhost:5432/anglehr_global?sslmode=disable

# --- SMTP / MailHog (email-worker) ---
# docker compose runs MailHog; email-worker defaults to host mailhog:1025 (no auth).
# Web UI: http://localhost:8025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@anglehr.local
SMTP_FROM_NAME=Angle HR
# Base URL used in email links (waitlist survey, admin invite accept, onboarding).
# Admin invite emails link to {{APP_URL}}/admin/accept-invite?token=...
# Invite tokens expire after 72 hours.
APP_URL=http://localhost:8080
