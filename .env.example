# Copy to .env and fill in real values. Never commit .env — it is listed in .gitignore.

# --- PostgreSQL (per-region and global registry passwords) ---
# Used by postgres_<region>, postgres_global, and migrate services in docker-compose.yml.
POSTGRES_PASSWORD_UK=change-me-uk
POSTGRES_PASSWORD_US=change-me-us
POSTGRES_PASSWORD_AFRICA=change-me-africa
POSTGRES_PASSWORD_EU=change-me-eu
POSTGRES_PASSWORD_GLOBAL=change-me-global

# --- MinIO (per-region root credentials) ---
# Used by minio_<region> services in docker-compose.yml.
MINIO_ROOT_USER_UK=minio_uk_user
MINIO_ROOT_PASSWORD_UK=change-me-minio-uk
MINIO_ROOT_USER_US=minio_us_user
MINIO_ROOT_PASSWORD_US=change-me-minio-us
MINIO_ROOT_USER_AFRICA=minio_africa_user
MINIO_ROOT_PASSWORD_AFRICA=change-me-minio-africa
MINIO_ROOT_USER_EU=minio_eu_user
MINIO_ROOT_PASSWORD_EU=change-me-minio-eu

# --- Application (server) ---
# For docker compose, server uses internal hostnames (postgres_uk, minio_uk, …).
# Run: docker compose up --build
SERVER_PORT=8080
APP_ENV=development

# Origin used by OpenAPI / Scalar (Try it out). Defaults to http://localhost:SERVER_PORT
PUBLIC_API_URL=http://localhost:8080

# --- Regional database router (server) ---
# All four regions are required at startup. Use the same passwords as POSTGRES_PASSWORD_* / MINIO_* above.
ANGLEHR_UK_POSTGRES_DSN=postgres://anglehr:change-me-uk@localhost:5432/anglehr_uk?sslmode=disable
ANGLEHR_UK_MINIO_ENDPOINT=localhost:9000
ANGLEHR_UK_MINIO_ACCESS_KEY=minio_uk_user
ANGLEHR_UK_MINIO_SECRET_KEY=change-me-minio-uk
ANGLEHR_UK_MINIO_BUCKET=anglehr-uk

ANGLEHR_US_POSTGRES_DSN=postgres://anglehr:change-me-us@localhost:5433/anglehr_us?sslmode=disable
ANGLEHR_US_MINIO_ENDPOINT=localhost:9002
ANGLEHR_US_MINIO_ACCESS_KEY=minio_us_user
ANGLEHR_US_MINIO_SECRET_KEY=change-me-minio-us
ANGLEHR_US_MINIO_BUCKET=anglehr-us

ANGLEHR_AFRICA_POSTGRES_DSN=postgres://anglehr:change-me-africa@localhost:5434/anglehr_africa?sslmode=disable
ANGLEHR_AFRICA_MINIO_ENDPOINT=localhost:9004
ANGLEHR_AFRICA_MINIO_ACCESS_KEY=minio_africa_user
ANGLEHR_AFRICA_MINIO_SECRET_KEY=change-me-minio-africa
ANGLEHR_AFRICA_MINIO_BUCKET=anglehr-africa

ANGLEHR_EU_POSTGRES_DSN=postgres://anglehr:change-me-eu@localhost:5435/anglehr_eu?sslmode=disable
ANGLEHR_EU_MINIO_ENDPOINT=localhost:9006
ANGLEHR_EU_MINIO_ACCESS_KEY=minio_eu_user
ANGLEHR_EU_MINIO_SECRET_KEY=change-me-minio-eu
ANGLEHR_EU_MINIO_BUCKET=anglehr-eu

# --- PostgreSQL URLs (host; migrate-up / psql from your machine) ---
# The server uses ANGLEHR_*_POSTGRES_DSN. migrate-up uses DB_URL_UK; migrate-all uses all DB_URL_* vars.
# Substitute the matching password from above (URL-encode special characters if needed).
DB_URL_UK=postgres://anglehr:change-me-uk@localhost:5432/anglehr_uk?sslmode=disable
DB_URL_US=postgres://anglehr:change-me-us@localhost:5433/anglehr_us?sslmode=disable
DB_URL_AFRICA=postgres://anglehr:change-me-africa@localhost:5434/anglehr_africa?sslmode=disable
DB_URL_EU=postgres://anglehr:change-me-eu@localhost:5435/anglehr_eu?sslmode=disable
DB_URL_GLOBAL=postgres://anglehr:change-me-global@localhost:5436/anglehr_global?sslmode=disable

# MinIO UK API: http://localhost:9000  Console: http://localhost:9001
# MinIO US API: http://localhost:9002  Console: http://localhost:9003
# MinIO Africa API: http://localhost:9004  Console: http://localhost:9005
# MinIO EU API: http://localhost:9006  Console: http://localhost:9007

# --- SMTP (worker) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me-smtp
SMTP_FROM=Angle HR <no-reply@anglehr.com>
APP_URL=https://app.anglehr.com

# --- River UI (starts with docker compose up; http://localhost:RIVER_UI_PORT) ---
RIVER_UI_PORT=8081
# RIVER_BASIC_AUTH_USER=dev
# RIVER_BASIC_AUTH_PASS=change-me