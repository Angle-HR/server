# Default repo for the Fluvio dashboard (Vite build arg for API base URL).
ARG FLUVIO_UI_GIT_URL=https://github.com/software78/fluvio_ui.git
ARG FLUVIO_UI_GIT_REF=v1.0.1

FROM node:22-alpine AS builder

# API is served from the server ingress host (CORS via FLUVIO_UI_ORIGIN on the server).
ARG VITE_API_BASE_URL=http://api.anglehr.local
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN apk add --no-cache git

WORKDIR /src
ARG FLUVIO_UI_GIT_URL
ARG FLUVIO_UI_GIT_REF
RUN git clone --depth 1 --branch "${FLUVIO_UI_GIT_REF}" "${FLUVIO_UI_GIT_URL}" .

RUN npm ci
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /src/dist /usr/share/nginx/html
COPY deploy/docker/fluvio-ui.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
