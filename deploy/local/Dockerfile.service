# Generic image for one extracted service: builds ./cmd/<SERVICE> into a small non-root image.
#
#   docker build -f deploy/local/Dockerfile.service --build-arg SERVICE=identity .
#
# Conventions every service binary follows (see docs/microservices/local-dev.md):
#   HTTP_ADDR  (default :8080)  serves /healthz (liveness) and /readyz (readiness)
#   GRPC_ADDR  (default :9090)  internal gRPC, never published to the host
FROM golang:1.26-alpine AS builder
ARG SERVICE
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN test -n "$SERVICE" || { echo "build arg SERVICE is required" >&2; exit 1; }
RUN test -d "cmd/$SERVICE" || { echo "cmd/$SERVICE does not exist yet: this service has not been extracted" >&2; exit 1; }
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/service "./cmd/$SERVICE"
# Operator one-offs shipped in every service image (they use the service's own environment and network):
#   docker compose run --rm --entrypoint totp-rekey identity -dry-run
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/totp-rekey ./cmd/totp-rekey

FROM alpine:3.21
ARG SERVICE
RUN apk add --no-cache ca-certificates wget tzdata \
    && addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
COPY --from=builder /out/service /usr/local/bin/service
COPY --from=builder /out/totp-rekey /usr/local/bin/totp-rekey

ENV SERVICE_NAME=$SERVICE \
    HTTP_ADDR=:8080 \
    GRPC_ADDR=:9090 \
    HEALTH_PATH=/healthz
USER 10001:10001
EXPOSE 8080 9090

# Health hook: the compose overlay may override this, but the default works for any service following the convention.
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=10 \
    CMD wget -q -O /dev/null "http://127.0.0.1:8080${HEALTH_PATH}" || exit 1

ENTRYPOINT ["/usr/local/bin/service"]
