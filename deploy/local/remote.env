# The local stack's service wiring: every route is owned by its service (the monolith no longer exists), gRPC
# between the services, events on, the BFFs validating sessions. `make local-up` loads this file first; a repo-root
# .env and variables in your shell override it. See docs/microservices/local-dev.md.
IDENTITY_REMOTE=on
ORG_REMOTE=on
HIRING_REMOTE=on
APPLICATIONS_REMOTE=on
IDENTITY_EVENTS=on
ORG_EVENTS=on
HIRING_EVENTS=on
APPLICATIONS_EVENTS=on
APPLICATIONS_JOBSOURCE=events
APPLICATIONS_JOBFALLBACK=off
CALLER_RESOLVER=grpc
APPLICANT_COUNTS=grpc
ORG_READINESS=grpc
ORG_MEMBERSHIP=grpc
ORG_ONBOARDING=grpc
ORG_APPLY=grpc
IDENTITY_QUEUE=grpc
SESSION_VALIDATION=on
ORG_TENANTS=grpc
ORG_NOTICE=grpc
ORG_COMPANY=grpc
IDENTITY_USERS=grpc
APPLICATIONS_ORG_EVENTS=on
HIRING_ORG_EVENTS=on
UPSTREAM_APPLICATIONS_URL=http://applications:8080
UPSTREAM_HIRING_URL=http://hiring:8080
UPSTREAM_ORG_URL=http://org:8080
UPSTREAM_IDENTITY_URL=http://identity:8080
